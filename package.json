{
  "name": "agent-im",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute agent-im-db --local --file=src/db/schema.sql && wrangler d1 execute agent-im-db --local --file=src/db/events.sql",
    "db:init:remote": "wrangler d1 execute agent-im-db --remote --file=src/db/schema.sql && wrangler d1 execute agent-im-db --remote --file=src/db/events.sql",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.md\"",
    "test": "node --import tsx --test --test-reporter=tap tests/*.test.ts",
    "secrets:setup": "node scripts/setup-secrets.mjs",
    "check:deploy": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "nanoid": "^5.1.5",
    "standardwebhooks": "^1.1.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261012.1-beta",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.1"
  }
}
